{
  "artifacts_dir": "artifacts",
  "results_dir": "results",
  "representation_version": "hdfs-rle-v1",
  "progress_every": 10,
  "data": {
    "version": "processed_v2/group_trace",
    "split_dir": "processed_v2/group_trace",
    "traces": "preprocessed/Event_traces.csv",
    "templates": "preprocessed/HDFS.log_templates.csv",
    "occurrence_matrix": "preprocessed/Event_occurrence_matrix.csv"
  },
  "subsets": {
    "validation": {"normal": 160, "anomaly": 40, "seed": 42},
    "test": {"normal": 400, "anomaly": 100, "seed": 42}
  },
  "embedding": {
    "model": "BAAI/bge-small-en-v1.5",
    "revision": "main",
    "device": "cpu",
    "batch_size": 16,
    "cpu_threads": 4
  },
  "llm": {
    "provider": "openai-compatible",
    "request_delay_seconds": 4.0,
    "rate_limit_retries": 5,
    "rate_limit_backoff_seconds": 10,
    "transient_retries": 3,
    "transient_backoff_seconds": 5,
    "reasoning_effort": "none",
    "temperature": 0,
    "max_output_tokens": 256,
    "output_token_parameter": "max_tokens",
    "json_mode": true,
    "timeout_seconds": 90
  },
  "m0": {"k_candidates": [1, 3, 5]}
}
