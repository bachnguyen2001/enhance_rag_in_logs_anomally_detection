{
  "artifacts_dir": "artifacts_protocol_v4",
  "results_dir": "results_protocol_v4",
  "llm_cache_dir": "cache_protocol_v4",
  "model_cache_dir": "artifacts/model_cache",
  "env_file": ".env",
  "representation_version": "hdfs-rle-ngram-knn-v1",
  "progress_every": 10,
  "data": {
    "version": "processed_v2/group_trace",
    "split_dir": "processed_v2/group_trace",
    "traces": "preprocessed/Event_traces.csv",
    "templates": "preprocessed/HDFS.log_templates.csv",
    "occurrence_matrix": "preprocessed/Event_occurrence_matrix.csv"
  },
  "embedding": {
    "model": "BAAI/bge-small-en-v1.5",
    "revision": "main",
    "device": "cuda",
    "batch_size": 16,
    "cpu_threads": 4
  },
  "llm": {
    "provider": "openai-compatible",
    "temperature": 0,
    "max_output_tokens": 256,
    "output_token_parameter": "max_tokens",
    "json_mode": true,
    "timeout_seconds": 90,
    "rate_limit_retries": 5,
    "rate_limit_backoff_seconds": 10,
    "transient_retries": 3,
    "transient_backoff_seconds": 5
  },
  "model_profiles": {
    "qwen-local": {
      "display_name": "Qwen2.5 7B Instruct (local)",
      "base_url": "http://192.168.56.1:1234",
      "chat_path": "/api/v1/chat",
      "payload_format": "input_text",
      "model": "qwen2.5-7b-instruct",
      "api_key_required": false,
      "request_delay_seconds": 0.2
    },
    "gemini": {
      "display_name": "Gemini 2.5 Flash",
      "use_env": true,
      "api_key_required": true,
      "api_key_env": "LLM_API_KEY",
      "reasoning_effort": "none",
      "request_delay_seconds": 4.0
    }
  }
}
